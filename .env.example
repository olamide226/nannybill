# Turso Database Configuration
# Copy this file to .env and fill in your connection details.
# The app will automatically connect and run migrations on startup.

# The HTTP or Libsql connection URL of your database (e.g. libsql://my-db-org.turso.io)
VITE_TURSO_DATABASE_URL=

# The authentication token for your database (optional for local/test instances, required for remote)
VITE_TURSO_AUTH_TOKEN=
